NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://orderflow:orderflow_local_password@localhost:5432/orderflow?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-random-secret
COOKIE_SECRET=replace-with-a-third-random-secret
CORS_ORIGINS=http://localhost:3000
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ENABLE_SWAGGER=true
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
